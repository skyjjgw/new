[Unit]
Description=VisionBridge edge-to-cloud mirror
After=network-online.target blind_occupancy_edge_iotsuite.service
Wants=network-online.target

[Service]
Type=simple
User=pi
EnvironmentFile=/home/pi/visionbridge-cloud-bridge.env
ExecStart=/usr/bin/python3 /home/pi/visionbridge_cloud_bridge.py
Restart=always
RestartSec=8
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
