# Copy to /etc/visionbridge/media-publisher.env as root:pi with mode 0640.
VISIONBRIDGE_DEVICE_ID=visionbridge-edge-01
VISIONBRIDGE_MEDIA_PUBLISH_SECRET=replace-with-random-media-publish-secret
VISIONBRIDGE_PREVIEW_URL=http://127.0.0.1:8090/stream.raw
VISIONBRIDGE_MEDIA_INPUT_FORMAT=rawvideo
VISIONBRIDGE_CLOUD_SSH_HOST=your-domain.example
VISIONBRIDGE_MEDIA_RTSP_HOST=127.0.0.1
VISIONBRIDGE_MEDIA_RTSP_PORT=18554
VISIONBRIDGE_MEDIA_FPS=15
VISIONBRIDGE_MEDIA_WIDTH=320
VISIONBRIDGE_MEDIA_HEIGHT=240
VISIONBRIDGE_MEDIA_BITRATE=450k
# Raspberry Pi 4: use h264_v4l2m2m when the bcm2835-codec encoder is available.
VISIONBRIDGE_MEDIA_ENCODER=h264_v4l2m2m
