[Unit]
Description=VisionBridge Edge Client - Direct Cloud Upload
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/blind_occupancy
ExecStart=/usr/bin/env bash /home/pi/blind_occupancy/run_blind_occupancy_edge.sh
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
Environment=HOME=/home/pi
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
